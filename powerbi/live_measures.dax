// These measures were created in the imported Power BI semantic model.
// The tables retain the Excel workbook's tbl prefixes.

Total Orders =
SUM('tblOrderSummary'[order_count])

Revenue =
CALCULATE(
    SUM('tblOrderSummary'[order_value_eur]),
    'tblOrderSummary'[order_status] <> "Cancelled"
)

On-Time Delivery % =
DIVIDE(
    SUM('tblShipmentSummary'[on_time_delivery_count]),
    SUM('tblShipmentSummary'[delivered_shipment_count])
)

Open Backlog =
CALCULATE(
    SUM('tblOrderSummary'[order_count]),
    'tblOrderSummary'[backlog_bucket] <> "Not Backlog"
)

Delivered Shipments =
SUM('tblShipmentSummary'[delivered_shipment_count])

Late Deliveries =
SUM('tblShipmentSummary'[late_delivery_count])

Late Delivery % =
DIVIDE([Late Deliveries], [Delivered Shipments])

Average Delay Days =
DIVIDE(
    SUM('tblShipmentSummary'[delivery_delay_days_sum]),
    SUM('tblShipmentSummary'[delivery_delay_observation_count])
)

Average Fulfilment Lead Time =
DIVIDE(
    SUM('tblShipmentSummary'[fulfilment_lead_time_days_sum]),
    SUM('tblShipmentSummary'[fulfilment_lead_time_observation_count])
)

Shipment Exception Rate =
DIVIDE(
    CALCULATE(
        SUM('tblShipmentSummary'[shipment_count]),
        'tblShipmentSummary'[exception_reason] <> "No Exception"
    ),
    SUM('tblShipmentSummary'[shipment_count])
)

SLA Breach % =
DIVIDE(
    SUM('tblOrderSummary'[sla_breach_order_count]),
    SUM('tblOrderSummary'[sla_eligible_order_count])
)

Backlog Over 7 Days =
CALCULATE(
    SUM('tblOrderSummary'[order_count]),
    'tblOrderSummary'[backlog_bucket] IN {"8–14 days", "15+ days"}
)

Stockout Snapshots =
SUM('tblInventorySummary'[stockout_snapshot_count])

Stockout Rate =
DIVIDE(
    [Stockout Snapshots],
    SUM('tblInventorySummary'[valid_snapshot_count])
)

Warehouse Throughput Units =
SUM('tblInventorySummary'[shipped_quantity])

// On-Time Delivery % was formatted as Percentage with two decimal places.
// Validation query run in Power BI DAX query view on 20 September 2026:
// EVALUATE ROW(
//     "Orders", [Total Orders],
//     "Revenue", [Revenue],
//     "OnTimePct", ROUND([On-Time Delivery %] * 100, 2),
//     "Backlog", [Open Backlog]
// )
// Result: 29873 | 3221285.15 | 62.32 | 688

