//     "LatePct", ROUND([Late Delivery %] * 100, 2),
//     "AvgDelay", ROUND([Average Delay Days], 2),
//     "LeadTime", ROUND([Average Fulfilment Lead Time], 2),
//     "ExceptionPct", ROUND([Shipment Exception Rate] * 100, 2),
//     "SLAPct", ROUND([SLA Breach %] * 100, 2),
//     "Backlog7", [Backlog Over 7 Days],
//     "StockoutPct", ROUND([Stockout Rate] * 100, 2),
//     "Throughput", [Warehouse Throughput Units]
// )
